
module cal (

	input logic clk,					// clock
	input logic rst,
	input logic strobe,				// active-high synchronous write enable
	input logic [3:0] token,			// infix expression input

	output logic ready,				// active-high ready to accept next token
	output logic [7:0] answer			// intermediate and final answers
);

	// functions
	parameter token_ADD	= 4'hA;
	parameter token_SUB	= 4'hB;
	parameter token_NULL	= 4'hC || 4'hD || 4'hF;
	parameter token_EQU	= 4'hE;

	// ff_calc states
	parameter fsm_IDLE			= 3'd0; // waiting for token
	parameter fsm_WAIT			= 3'd1; // waiting for shunting yard
	parameter fsm_CALC			= 3'd2; // calculate answer
	parameter fsm_PUSH_NUMBER	= 3'd3; // push number onto stack
	parameter fsm_EXECUTE		= 3'd4; // do arithmetic function
	parameter fsm_NONE		= 3'd5;

	// convert infix to RPN
	logic rd_en;					// active-high synchronous read enable for shunting yard output_queue
	logic shunt_yard_ready;		// active-high when shunting yard is ready to accept next token
	logic [6:0] output_queue;	// shunting yard postfix expression output
	logic op;
	logic output_stb;
	
	

	// helper signals
	logic is_equal;
	logic is_number ;
	logic is_finished  ;
	//
	assign is_equal = (token_EQU == token) ? 1'b1 : 1'b0;
	assign is_number = (op || token_EQU==output_queue) ? 1'b0 : 1'b1;
	assign is_finished = (token_EQU==output_queue) ? 1'b1 : 1'b0;

	// ff_calc FSM
    logic [2:0] state ;
    logic [2:0] next_state ;
    always @(posedge clk) begin
      if (rst) state <= fsm_IDLE;
      else state <= next_state;
    end

    // next state logic
    always_comb begin
    next_state = fsm_IDLE;
      case (state)
		// idle, wait for a token
        fsm_IDLE  : if (strobe) next_state = fsm_WAIT;
					else next_state = fsm_IDLE;

		// wait for shunting yard
		fsm_WAIT : if (shunt_yard_ready) next_state = is_equal ? fsm_CALC : fsm_IDLE;
				   else next_state = fsm_WAIT;

		// do calculation
        fsm_CALC : if (is_number) next_state = fsm_PUSH_NUMBER;
				   else next_state = is_finished ? fsm_IDLE : fsm_EXECUTE;

		// push number onto stack
        fsm_PUSH_NUMBER : next_state = fsm_CALC;

		// do operation
		fsm_EXECUTE : next_state = fsm_NONE;
		fsm_NONE : next_state = fsm_CALC;

        default: next_state = fsm_IDLE;
      endcase
    end

	// FSM outputs
	assign ready = (fsm_IDLE==state);
	assign rd_en = (fsm_PUSH_NUMBER==state) | (fsm_EXECUTE==state);

	// stack
	logic [6:0] stack[0:4];
        logic [2:0] stack_pointer = 3'd0;
        logic [7:0] accumulator;
    always @(posedge clk) begin
		if (fsm_PUSH_NUMBER==state) stack[stack_pointer] <= output_queue;
		else if (fsm_NONE==state) stack[stack_pointer-2] <= accumulator;
	end

	
    always @(posedge clk) begin
		if (rst) stack_pointer <= 3'd0;
		else if (fsm_PUSH_NUMBER==state) stack_pointer <= stack_pointer + 1'd1;
		else if (fsm_NONE==state) stack_pointer <= stack_pointer - 1'd1;
	end

	// ALU
	
	always @(posedge clk) begin
	if (fsm_EXECUTE == state) begin
		case (output_queue)
			token_ADD : accumulator <= stack[stack_pointer-2] + stack[stack_pointer-1];
			token_SUB : accumulator <= stack[stack_pointer-2] - stack[stack_pointer-1];	
			default : accumulator = 7'd0;
		endcase
	end
	end
  
	// update output
	logic [6:0] dis
    always @(posedge clk) begin
		if (rst) answer <= 4'd0;
		else if (is_finished) answer <= accumulator;
		else if (fsm_WAIT == state && output_stb) answer[6:0] <= dis;
	end
	
   conv shunt_yard(
		.clk(clk),
		.rst(rst),
		.rd_en(rd_en),
		.wr_en(strobe),
		.token(token),
		.ready(shunt_yard_ready),
		.output_stb(output_stb),
		.op(op),
		.display(dis),
		.output_queue(output_queue)
	);
endmodule