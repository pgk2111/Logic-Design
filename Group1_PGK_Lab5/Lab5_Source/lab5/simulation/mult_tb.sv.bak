`timescale 1 ns/100 ps
module mult_tb ();
 //----------------------------------------------------------
 // inputs to the DUT are reg type
logic [31:0] A,B;
logic [18:0] out;
logic sel;

 //----------------------------------------------------------
 // instantiate the Device Under Test (DUT)
 // using named instantiation
div U1 (
          .a(A[31:13]),
          .b(B[31:13]),
          .add_sel(sel),
          .result(out)
        );


initial begin
A = 32'b00000000110000000001100110001111;
B = 32'b00110101000000000011101010011100;
sel = 1'b1;
#100
A= 32'b11001001111000011101000000101001;
B= 32'b10000110000001000000101010000010;
#100
A = 32'b0;
B = 32'b0;
A[31:13] = 19'b0100000100000000000;
B[31:13] = 19'b0100000010000000000;
#100
$finish;

end
endmodule